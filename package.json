{
  "name": "yakap-bear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml",
    "dev:all": "node scripts/dev.mjs",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:api": "cargo test --manifest-path backend/Cargo.toml -- --test-threads=1",
    "db:seed": "cargo run --manifest-path backend/Cargo.toml -- seed",
    "db:migrate": "cargo run --manifest-path backend/Cargo.toml -- migrate",
    "db:local:init": "node scripts/local-db.mjs init",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "jose": "^6.2.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
