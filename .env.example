# Optional. Leave these blank to run the offline demo in Expo Go.
# Copy this file to .env and restart Expo with: npx expo start --clear
#
# Use only the public anon key here. Anything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put a Supabase service-role key in this project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
