# ───────────────────────────────────────────────────────────────
# Yakap Bear prototype — environment template
# Copy to `.env` in the repository root (never commit `.env`).
# The Rust API (backend/) and the Next.js frontend both read this file.
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection for the Rust API.
#   Local: postgresql://postgres@localhost:5432/yakap
#   Neon:  use the DIRECT (non-pooled) connection string, e.g.
#          postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/yakap?sslmode=require
DATABASE_URL=

# Signs the session cookies. 32+ random characters. MUST be identical for the
# Rust API and the Next.js frontend (the page guard verifies the same token).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Enables demo clock controls, demo reset and simulator pairing.
DEMO_MODE=true

# Device token given to the seeded simulated bears (BEAR-0001 …).
BEAR_DEVICE_KEY=

# Where Next.js forwards /api/* (the Rust API).
API_URL=http://localhost:8080

# Rust API options
PORT=8080
# Add `Secure` to cookies — set true when the site is served over HTTPS.
COOKIE_SECURE=false
# Apply database migrations automatically when the API starts.
AUTO_MIGRATE=true

# Separate database for the Rust integration tests (`npm run test:api`).
#   Local: postgresql://postgres@localhost:5432/yakap_test
TEST_DATABASE_URL=
